# Google OAuth Client ID (keep existing public client if still used during staging)
VITE_GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com

# Worker staging URL used only for preparation/testing
VITE_APPS_SCRIPT_URL=https://your-worker-subdomain.workers.dev

# Optional visible backend version label
VITE_BACKEND_VERSION=workers-staging
